{
  "openapi": "3.0.3",
  "info": {
    "title": "Resenha Campo 5 — contratos estruturais de autenticação fictícia",
    "version": "0.1.0",
    "description": "PROPOSTA DE ENSAIO. Sem autenticação pública aprovada. Credencial Header Auth não pode ser colocada no bundle React. Native Crypto é usado em vez de imports no Code. E-mail não é enviado. Corpo de erro do Header Auth pode seguir padrão n8n antes do workflow."
  },
  "servers": [
    {
      "url": "https://n8n.saintsolution.com.br/webhook",
      "description": "Base informada; os novos caminhos não foram publicados nem invocados."
    }
  ],
