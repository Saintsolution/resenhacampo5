  "components": {
    "securitySchemes": {
      "ChaveEnsaio": {
        "type": "apiKey",
        "in": "header",
        "name": "X-RC5-HML-Key",
        "description": "Segredo definido em credencial gerenciada n8n, não neste arquivo."
      },
      "SessaoBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token fictício de 64 caracteres hex retornado apenas no login; não usar em URL ou localStorage."
      }
    },
    "schemas": {
      "Resposta": {
        "type": "object",
        "required": [
          "sucesso",
          "codigo",
          "mensagem",
          "modo"
        ],
        "properties": {
          "sucesso": {
            "type": "boolean"
          },
          "codigo": {
            "type": "string"
          },
          "mensagem": {
            "type": "string"
          },
          "modo": {
            "type": "string",
            "enum": [
              "TESTE_FICTICIO"
            ]
          },
          "autenticado": {
            "type": "boolean"
          },
          "participante_id": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "papel_administrativo": {
            "type": "string"
          },
          "token_sessao": {
            "type": "string",
            "description": "SOMENTE login fictício bem-sucedido. Não é um hash nem faz parte da consulta de sessão."
          },
          "expira_em": {
            "type": "string",
            "format": "date-time"
          },
          "email_enviado": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "proxima_acao": {
            "type": "string"
          }
        }
      }
    }
  }
}
