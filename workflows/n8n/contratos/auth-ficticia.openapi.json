      "post": {
        "summary": "primeiro-acesso — somente ensaio fictício; não homologado",
        "operationId": "rc5_fixture_primeiro_acesso",
        "security": [
          {
            "ChaveEnsaio": []
          }
        ],
        "responses": {
          "200": {
            "description": "Operação fictícia concluída; sessão/login/logout/criação/redefinição",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          },
          "202": {
            "description": "Solicitação recebida; email_enviado=false neste pacote",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          },
          "400": {
            "description": "Entrada ou token inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          },
          "401": {
            "description": "Chave de ensaio inválida, credenciais ou sessão inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          },
          "403": {
            "description": "Origem não autorizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          },
          "429": {
            "description": "Limite do ensaio atingido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          },
          "503": {
            "description": "Homologação bloqueada, dependência indisponível ou resultado indeterminado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Resposta"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "cpf": {
                    "type": "string"
                  },
                  "cpf_assoc": {
                    "type": "string",
                    "deprecated": true
                  }
                },
                "required": [],
                "anyOf": [
                  {
                    "required": [
                      "cpf"
                    ]
                  },
                  {
                    "required": [
                      "cpf_assoc"
                    ]
